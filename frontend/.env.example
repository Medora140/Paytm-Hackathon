# =====================================================================
# Frontend Environment Configuration (Vercel / Production)
# Configure these variables in your Vercel Project Settings -> Environment Variables
# =====================================================================

# Backend API Endpoint (Points to your Render backend web service)
# Example for Render: https://money-docs-decoded-api.onrender.com
# Example for Local Dev: http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=https://your-backend-api.onrender.com

# Supabase Public Configuration
# Used for client-side authentication and session retrieval
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_optional_publishable_key
