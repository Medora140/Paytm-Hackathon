# ==============================================
# Money Docs Decoded - Environment Configuration
# ==============================================

# LLM Reasoning Engine (Sarvam AI)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=sarvam-m
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# Database & Storage (Supabase / PostgreSQL + pgvector)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# n8n Automation & MCP Orchestration
# Note: n8n is integrated as an MCP server; these credentials manage webhook callbacks
N8N_BASE_URL=https://your-n8n-instance.example.com
N8N_WEBHOOK_SECRET=your_shared_webhook_secret_here

# OCR Configuration
# Supported: tesseract
OCR_ENGINE=tesseract
TESSERACT_CMD_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# API Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_STORAGE_BUCKET=InsuranceFiles
# Set true on Render. Render's local disk is ephemeral.
REQUIRE_REMOTE_STORAGE=false
