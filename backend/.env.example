# =====================================================================
# Backend Environment Configuration (Render / Production)
# =====================================================================

# Server Configuration
PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated list of origins)
# Note: All *.vercel.app preview and production URLs are automatically permitted via regex
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Supabase (Database, Auth, Object Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# OCR & Embeddings
OCR_ENGINE=tesseract
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Demo fallback mode (Set to "false" in production to require real database)
DEMO_MODE=false
